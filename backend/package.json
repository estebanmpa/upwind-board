{
  "name": "upwind-board-backend",
  "version": "0.0.1",
  "description": "Upwind Board API: IKO kitesurf lessons and student progression",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "NODE_ENV=production node dist/main",
    "lint": "oxlint --type-aware src/",
    "typeorm": "typeorm -d dist/infrastructure/persistence/type-orm/data-source.js",
    "migration:run": "yarn build && typeorm migration:run -d dist/infrastructure/persistence/type-orm/data-source.js",
    "migration:run:prod": "typeorm migration:run -d dist/infrastructure/persistence/type-orm/data-source.js",
    "migration:revert": "yarn build && typeorm migration:revert -d dist/infrastructure/persistence/type-orm/data-source.js",
    "migration:show": "yarn build && typeorm migration:show -d dist/infrastructure/persistence/type-orm/data-source.js",
    "migration:generate": "sh -c 'test -n \"$0\" && [ \"$0\" != sh ] || { echo \"Usage: yarn migration:generate <MigrationName>\"; exit 1; }; yarn build && typeorm migration:generate -d dist/infrastructure/persistence/type-orm/data-source.js \"src/infrastructure/persistence/type-orm/migrations/$0\"'",
    "migration:check":"yarn build && typeorm migration:generate --check --dryrun -d dist/infrastructure/persistence/type-orm/data-source.js src/infrastructure/persistence/type-orm/migrations/Check"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "^12.0.4",
    "@nestjs/typeorm": "^12.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^1.1.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "typescript": "^6.0.2",
    "vite": "^8.0.0"
  }
}
