# HTTP
PORT=3000

# PostgreSQL (matches docker-compose.yml defaults)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=upwind
DB_PASSWORD=upwind
DB_NAME=upwind_board
# Database used by `yarn test:e2e` (created by docker/postgres-init)
DB_NAME_TEST=upwind_board_test
# Log SQL queries (true/false)
DB_LOGGING=false
