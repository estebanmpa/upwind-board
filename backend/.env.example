# HTTP
PORT=5001
# Comma-separated origins allowed by CORS (e.g. https://app.upwindboard.com).
# Leave empty in local development: the Vite dev server proxies /api.
CORS_ORIGINS=

# PostgreSQL. Defaults match the root docker-compose.yml, where the database
# is reachable as `upwind-board-db`. Running yarn commands on the host instead?
# Use DB_HOST=localhost and DB_PORT=5434.
DB_HOST=upwind-board-db
DB_PORT=5432
DB_USERNAME=localuser
DB_PASSWORD=localpassword
DB_NAME=upwindboarddb
# Log SQL queries (true/false)
DB_LOGGING=false
