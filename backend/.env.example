# HTTP
PORT=5001
# Comma-separated origins allowed by CORS: the web app's URL
# (e.g. https://app.upwindboard.com in production).
CORS_ORIGINS=http://localhost:5000

# PostgreSQL. Defaults match the root docker-compose.yml, where the database
# is reachable as `upwind-board-db`. Running yarn commands on the host instead?
# Use DB_HOST=localhost and DB_PORT=5434.
DB_HOST=upwind-board-db
DB_PORT=5432
DB_USERNAME=localuser
DB_PASSWORD=localpassword
DB_NAME=upwindboarddb
# Log SQL queries (true/false)
DB_LOGGING=false

# development | production. In production the session cookie is Secure and
# SameSite=None (the web app and the API live on different domains).
NODE_ENV=development

# IAM (identity provider). Register this app as an OAuth client in the IAM
# with the callback URL below as its redirect URL.
# IAM_BASE_URL is how this backend reaches the IAM: with docker compose both
# stacks share `backend-network`, where the IAM is `iam-backend-container`.
IAM_BASE_URL=http://iam-backend-container:3001
IAM_CLIENT_ID=
IAM_CLIENT_SECRET=
# Frontend page the IAM sends the user back to after login.
IAM_CALLBACK_URL=http://localhost:5000/callback

# Redis: sessions, IAM discovery cache and session-renewal locks.
# Running yarn commands on the host? Use redis://localhost:6381.
REDIS_URL=redis://upwind-board-cache:6379
