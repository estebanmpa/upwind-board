# Development: the Vite dev server forwards /api/* to this URL.
# With docker compose the API is reachable as `upwind-board-server`;
# running `yarn dev` on the host instead? Use http://localhost:5001.
VITE_API_PROXY_TARGET=http://upwind-board-server:5001

# Production build: public URL of the API (e.g. https://api.upwindboard.com).
# Leave empty in development to go through the /api proxy.
VITE_API_URL=
